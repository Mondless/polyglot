{
  "schemaVersion": 1,
  "id": "polylingo",
  "version": "${version}",
  "name": "Polylingo",
  "description": "Shows additional item tooltips in the languages selected by the player.",
  "authors": ["Mondless"],
  "contact": {},
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "client": [
      "net.mondless.polylingo.PolylingoClient"
    ],
    "modmenu": [
      "net.mondless.polylingo.compat.ModMenuIntegration"
    ]
  },
  "mixins": [
    {
      "config": "polylingo.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.20.1",
    "minecraft": "~26.3",
    "java": ">=25",
    "fabric-api": "*"
  },
  "suggests": {
    "modmenu": "*"
  }
}
