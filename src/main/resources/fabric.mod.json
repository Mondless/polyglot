{
  "schemaVersion": 1,
  "id": "polyglot",
  "version": "${version}",
  "name": "Polyglot",
  "description": "Shows additional item tooltips in the languages selected by the player.",
  "authors": ["Mondless"],
  "contact": {},
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "client": [
      "net.mondless.polyglot.PolyglotClient"
    ],
    "modmenu": [
      "net.mondless.polyglot.compat.ModMenuIntegration"
    ]
  },
  "mixins": [
    {
      "config": "polyglot.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.20.1",
    "minecraft": "~26.3",
    "java": ">=25",
    "fabric-api": "*"
  },
  "suggests": {
    "modmenu": "*"
  }
}
